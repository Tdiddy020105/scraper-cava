# Sleutels blijven lokaal. Dit bestand kopieer je naar .env en vul je daar in.
# .env wordt niet door de scraper naar een pagina geschreven.

# objectinformatie (standaard): Kadata Objectinformatie, product "rechten",
# € 2,96 per adres. Abonnement Mijn Kadaster met Kadata Internet.
# Sleutel aanvragen in Kadata Internet. Header: X-API-KEY.
# https://kadatawebservice.kadaster.nl/objectinformatieapi/swagger/index.html
#
# contractloos: € 0,82 per adres. Bedoeld voor nutsbedrijven zonder leveringscontract.
# https://kadatawebservice.kadaster.nl/contractloos/swagger/index.html
#
# brk: alleen voor BSN-gerechtigde overheden. API-sleutel en doorgaans een
# PKIoverheid-certificaat. https://api.brk.kadaster.nl/esd/bevragen/v2/
KADASTER_PRODUCT=objectinformatie
KADASTER_API_KEY=
# Optioneel. Volledige basis-URL als je niet de productie-URL gebruikt.
KADASTER_API_BASE=
# Alleen voor BRK met mTLS.
KADASTER_CERT_FILE=
KADASTER_KEY_FILE=

# KVK Handelsregister. Sleutel uit https://developers.kvk.nl/ (header: apikey).
# Zoeken en Basisprofiel zijn aparte producten; Basisprofiel is betaald.
# Het register levert naam, KVK-nummer, bezoekadres en websites, geen e-mail of telefoon.
KVK_API_KEY=
KVK_API_BASE=https://api.kvk.nl
